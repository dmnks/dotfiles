# @TODO: finish replacing the colors here


# Menu
menu.border.color: #d8a657
menu.border.width: 1
menu.overlap.x: -10

menu.title.bg: Solid Flat
menu.title.bg.color: #f2e5bc
menu.title.bg.shadow: 0
menu.title.text.color: #3c3836
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #fbf1c7
menu.items.text.color: #3c3836
menu.items.disabled.text.color: #928374

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #d8a657
menu.items.active.text.color: #282828

menu.separator.color: #3c3836
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 6

# Active window
window.active.border.color: #f9f5d7


window.active.title.bg: flat solid
window.active.title.bg.color: #ebdbb2
window.active.title.separator.color: #ebdbb2
window.active.client.color: #f2e5bc
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #3c3836

window.active.handle.bg: flat solid
window.active.handle.bg.color: #d8a657

window.active.grip.bg: flat solid
window.active.grip.bg.color: #f9f5d7

# Inactive window
window.inactive.border.color: #f9f5d7

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #f9f5d7
window.inactive.title.separator.color: #f9f5d7
window.inactive.client.color: #5a524c
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #928374

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #928374

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #ebdbb2

# OSD
osd.border.width: 1
osd.border.color: #d8a657

osd.bg: flat solid
osd.bg.color: #f2e5bc
osd.bg.shadow: 0
osd.label.bg: flat solid
osd.label.bg.color: #f2e5bc
osd.label.text.color: #3c3836

osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #d8a657
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #f2e5bc

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #f2e5bc
osd.button.unpressed.text.color: #d5c4a1
osd.button.unpressed.*.border.color: #928374

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #d8a657
osd.button.pressed.text.color: #fbf1c7
osd.button.pressed.*.border.color: #928374

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #f2e5bc
osd.button.focused.text.color: #d5c4a1
osd.button.focused.*.border.color: #928374

osd.button.focused.box.color: #d5c4a1
osd.button.pressed.box.color: #fbf1c7

osd.window-switcher.style-classic.item.padding.x: 10
osd.window-switcher.style-classic.item.padding.y: 5
osd.window-switcher.style-classic.item.active.border.color: #3584e4

# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
# Uncomment line below and change <padding> to a number to enable menu item padding
# menu.items.font:shadow=y:shadowtint=0:shadowoffset=<padding>
menu.title.text.font:shadow=n


# Everything else
border.width: 1
padding.width: 10
padding.height: 10
window.handle.width: 0
window.client.padding.height: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0

# Custom
window.active.shadow.size: 100
window.inactive.shadow.size: 100
osd.window-switcher.preview.border.width: 3
osd.window-switcher.preview.border.color: #3584e4
snapping.overlay.edge.bg.color: #3584e480
window.titlebar.padding.width: 6
window.titlebar.padding.height: 6
