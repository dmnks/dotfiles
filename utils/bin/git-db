#!/bin/bash

TMPDIR=$(mktemp -d)
git -C $TMPDIR init
git rev-list --reverse "$@" | \
while read commit; do
    msg=$(git rev-list -n1 --format=%B "$commit")
    sub=$(echo "$msg" | sed -n 2p)
    sha=$(echo "$msg" | sed -n 1p | sed 's/^commit //')
    org=$(echo "$msg" | sed -n 's/^(backported from commit \(.*\))/\1/p')
    [ -z "$org" ] && continue

    git show $org > $TMPDIR/$org
    git -C $TMPDIR add $org
    git -C $TMPDIR commit -m "Init: $sub"

    git show $sha > $TMPDIR/$org
    git -C $TMPDIR add $org
    git -C $TMPDIR commit -m "Port: $sub"
done
tig -C $TMPDIR
rm -rf "$TMPDIR"
