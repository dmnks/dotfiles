#!/bin/bash

CMD=$1
shift

showtui() {
    foot -c ~/.config/foot/xterm.ini --title "$@"
}

case $CMD in
    theme)
        case $1 in
            status)
                name=$(gsettings get org.gnome.desktop.interface color-scheme)
                if [ "$name" == "'default'" ]; then
                    echo ""
                    echo "Light mode"
                else
                    echo ""
                    echo "Dark mode"
                fi
                ;;
            toggle)
                ~/bin/set-theme
                ;;
        esac
        ;;
    nmtui)
        showtui 'NetworkManager TUI' nmtui
        ;;
    bluetooth)
        devs=$(bluetoothctl devices)
        id=$(echo "$devs"| cut -d' ' -f2)
        name=$(echo "$devs"| cut -d' ' -f3-)
        [ -z "$id" ] && exit
        connected=$(bluetoothctl info $id | grep Connected | awk '{print $2}')
        case $1 in
            connect)
                [ "$connected" == "yes" ] && exit
                notify-send -e "Bluetooth: Connecting device $name"
                if bluetoothctl connect $id >/dev/null 2>&1; then
                    notify-send -e "Bluetooth: Connected device $name"
                else
                    notify-send -e "Bluetooth: Couldn't connect device $name"
                fi
                ;;
            disconnect)
                [ "$connected" == "no" ] && exit
                    notify-send -e "Bluetooth: Disconnecting device $name"
                if bluetoothctl disconnect $id >/dev/null 2>&1; then
                    notify-send -e "Bluetooth: Disconnected device $name"
                fi
                ;;
        esac
        ;;
    casting)
        case $1 in
            status)
                wlr-randr | grep -q ScreenCasting || exit
                echo "󰀟"
                echo "Virtual Output enabled"
                echo "enabled"
                ;;
            view)
                wlrctl toplevel focus at.yrlf.wl_mirror || \
                wl-mirror ScreenCasting
                ;;
            start)
                pkill -RTMIN+9 waybar
                wlr-randr --output ScreenCasting --custom-mode 1920x1080
                ;;
            stop)
                pkill -RTMIN+9 waybar
                ;;
        esac
        ;;
    toggle)
        if [ $# == 0 ]; then
            app=$(playerctl metadata --format '{{playerName}}')
        else
            app=$1
        fi
        wlrctl toplevel focus $app
        ;;
esac
