#!/bin/bash

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS
    --prompt='  '
    --layout=reverse
    --color='pointer:$ACCENT_FG,prompt:$ACCENT_FG'
    --color='marker:$ACCENT_FG,spinner:$ACCENT_FG'
    --color='hl+:$ACCENT_FG,border:$THEME_COLOR_DIM2,input-border:$THEME_COLOR_DIM5,input-bg:$THEME_COLOR_DIM5'
    --color='hl:$THEME_COLOR_DIM1,fg+:$THEME_COLOR_ACTIVE_FG'
    --color='bg+:$THEME_COLOR_ACTIVE_BG0,header:$THEME_COLOR_DIM2,ghost:$THEME_COLOR_DIM6'
    --color='scrollbar:$THEME_COLOR_DIM4,info:$THEME_COLOR_DIM2,gutter:-1'
    --input-border=block
    --no-bold
    --info=inline-right
    --scrollbar=█
    --pointer=' '
    --header=''
    --border=none
    --padding=0
    --no-separator
    --highlight-line
    --no-mouse
"

exec /usr/bin/fzf "$@"
