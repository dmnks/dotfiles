#!/bin/bash

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS
    --prompt='  '
    --layout=reverse
    --color='gutter:-1'
    --no-bold
    --info=inline-right
    --scrollbar=█
    --pointer=▎
    --header=''
    --border=none
    --padding=0,1
    --no-separator
    --highlight-line
    --no-mouse
"

exec /usr/bin/fzf "$@"
