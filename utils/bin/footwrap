#!/bin/bash

CMD=$1
shift

case $CMD in
    monitor)
        gsettings monitor org.gnome.desktop.interface | \
        while read key; do
            [[ $key =~ ^(color-scheme) ]] || continue
            val=$(echo "$key" | awk '{print $2}' | tr -d \')
            if [ "$val" == "prefer-dark" ]; then
                killall -s SIGUSR1 foot
            else
                killall -s SIGUSR2 foot
            fi
        done
        ;;
    launch)
        val=$(dconf read /org/gnome/desktop/interface/color-scheme | tr -d \')
        config=

        if [ "$val" == "prefer-dark" ]; then
            theme=dark
        else
            theme=light
        fi

        case $1 in
            -c)
                config="-c $HOME/.config/foot/$2.ini"
                shift 2
                ;;
        esac

        exec foot $config -o main.initial-color-theme=$theme "$@"
        ;;
esac
